{
    "name": "@elucidate-crm/backend",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "start": "node dist/src/server.js",
        "build": "tsc -p tsconfig.json",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "lint": "eslint src scripts tests",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "node --input-type=module -e \"import('./dist/tests/lead-eligibility.test.js')\"",
        "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
        "admin:reset-password": "tsx scripts/reset-admin-password.ts",
        "server": "tsx src/server.ts"
    },
    "dependencies": {
        "@elucidate-crm/shared": "file:../shared",
        "@prisma/client": "^6.19.0",
        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^18.0.10",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.4",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "node-cron": "^4.6.0",
        "pino": "^10.4.0",
        "web-push": "^4.0.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.9",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.5",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node-cron": "^3.0.11",
        "@types/web-push": "^3.6.4",
        "prisma": "^6.19.0",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
