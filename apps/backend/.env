# Backend runtime configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5174
LOG_LEVEL=info




# Prisma/MySQL connection for the schema in prisma/schema.prisma.
# Example: mysql://USER:PASSWORD@localhost:3306/elucidate_crm
DATABASE_URL=mysql://root:@127.0.0.1:3306/erp-software

# Use independent random secrets with at least 32 characters each.
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters

# Optional web push configuration. Leave blank to disable push notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://localhost

# Optional lead eligibility job schedule (UTC, cron format).
CLAIM_JOB_CRON=0 * * * *
